{
	"schemaVersion": 1,
	"id": "genesis",
	"version": "${version}",
	"name": "Genesis",
	"description": "这是棱光工作室最牛逼的模组",
	"authors": [
		"YiTPac_",
		"Hulue(to join)"
	],
	"contact": {
		"homepage": "https://fabricmc.net/",
		"sources": "https://github.com/FabricMC/fabric-example-mod"
	},
	"license": "CC0-1.0",
	"icon": "assets/genesis/icon.png",
	"environment": "*",
